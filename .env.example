# Salin menjadi .env lalu sesuaikan. Jangan commit file .env.
PORT=5178
# Origin publik aplikasi web. Wajib sama dengan origin yang membuka UI (dipakai untuk cek CSRF).
APP_ORIGIN=http://localhost:5178
# Lokasi database SQLite.
DB_PATH=./data/linkly.db
# Masa berlaku sesi (hari).
SESSION_DAYS=14

# --- Google OAuth 2.0 / OpenID Connect (opsional) ---
# Buat OAuth client tipe "Web application" di Google Cloud Console.
# Authorized redirect URI: http://localhost:5178/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5178/api/google/callback

# Kunci enkripsi 32 byte untuk menyimpan refresh token Google (hex atau base64).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Jika kosong, Linkly tidak menyimpan refresh token dan tidak dapat memanggil
# endpoint pencabutan token Google secara langsung.
ENCRYPTION_KEY=
